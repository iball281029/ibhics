[Unit]
Description=ibHiCS manager (web console and API)
After=network-online.target libvirtd.service
Wants=network-online.target
ConditionPathExists=/etc/ibhics/configured

[Service]
EnvironmentFile=/etc/ibhics/ibhics.env
ExecStart=/opt/ibhics/venv/bin/ibhics-manager
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
